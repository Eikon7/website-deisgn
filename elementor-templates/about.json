            {
              "id": "3852d29",
              "elType": "widget",
              "settings": {
                "editor": "<p>Suluh exists to carry light where it is needed most. We <b style=\"color:#fff\">illuminate</b> public life with ideas grounded in evidence and values. We <b style=\"color:#fff\">empower</b> communities to lead their own change. We <b style=\"color:#fff\">equip</b> the next generation, and the wider public, to see and shape the future.</p><p style=\"margin-top:18px\"><span style=\"background:rgba(244,160,163,.18);color:#F4A0A3;border-radius:8px;padding:6px 14px;font-size:13px;font-weight:600;margin-right:8px;display:inline-block\">Illuminate &rarr; Ideas</span><span style=\"background:rgba(244,160,163,.18);color:#F4A0A3;border-radius:8px;padding:6px 14px;font-size:13px;font-weight:600;margin-right:8px;display:inline-block\">Empower &rarr; Community</span><span style=\"background:rgba(244,160,163,.18);color:#F4A0A3;border-radius:8px;padding:6px 14px;font-size:13px;font-weight:600;display:inline-block\">Equip &rarr; Youth &amp; Education</span></p>",
