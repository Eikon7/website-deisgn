            {
              "id": "e01ecae",
              "elType": "widget",
              "settings": {
                "editor": "<p>The SEA Women\u2019s Leadership Conference: Women, Peace and Security is a regional platform that brings together women leaders, policymakers, practitioners and emerging changemakers from across Southeast Asia. It creates a space to exchange perspectives, build regional connections and strengthen women\u2019s role in shaping the decisions that affect peace, security and the future of our communities.</p>",
                "text_color": "#2A3B32",
                "typography_typography": "custom",
                "typography_font_family": "Manrope",
                "typography_font_size": {
                  "unit": "px",
                  "size": 17,
                  "sizes": []
                },
                "typography_line_height": {
                  "unit": "em",
                  "size": 1.72,
                  "sizes": []
                },
                "align": "left"
              },
