            {
              "id": "ea0817b",
              "elType": "widget",
              "settings": {
                "editor": "<p>An intimate learning session exploring Surah Maryam through Qur\u2019anic scholarship and reflection, led by Shaykh Dr Mohammad Akram Nadwi. The session draws timeless lessons from the women and stories within the surah and connects them to questions of faith, resilience and life today.</p>",
                "text_color": "#2A3B32",
                "typography_typography": "custom",
                "typography_font_family": "Manrope",
                "typography_font_size": {
                  "unit": "px",
