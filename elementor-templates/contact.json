              "settings": {
                "html": "<div class=\"contact-card\"><h4>Send a message</h4><form id=\"c2ContactForm\" novalidate><div class=\"contact-field\"><label for=\"ccName\">Name</label><input type=\"text\" id=\"ccName\" name=\"name\" required></div><div class=\"contact-field\"><label for=\"ccOrg\">Organisation</label><input type=\"text\" id=\"ccOrg\" name=\"organisation\"></div><div class=\"contact-field\"><label for=\"ccEmail\">Email</label><input type=\"email\" id=\"ccEmail\" name=\"email\" required></div><div class=\"contact-field\"><label for=\"ccMessage\">Message</label><textarea id=\"ccMessage\" name=\"message\" required></textarea></div><button class=\"btn2\" type=\"submit\">Send <svg><use href=\"#c2-ico-arrow\"/></svg></button><p class=\"contact-status\" id=\"ccStatus\" role=\"status\" aria-live=\"polite\"></p></form></div>"
              },
