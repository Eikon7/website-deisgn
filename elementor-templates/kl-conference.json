            },
            {
              "id": "8cb5b82",
              "elType": "widget",
              "settings": {
                "editor": "<p>The Kuala Lumpur Conference on a New, Just and Humane International Order brought together political leaders, policymakers, thinkers and civil society voices to reimagine a global system grounded in justice, equality, solidarity and human dignity.</p>",
                "text_color": "#2A3B32",
                "typography_typography": "custom",
                "typography_font_family": "Manrope",
                "typography_font_size": {
                  "unit": "px",
                  "size": 17,
                  "sizes": []
                },
                "typography_line_height": {
                  "unit": "em",
                  "size": 1.72,
                  "sizes": []
                },
                "align": "left"
              },
              "elements": [],
              "widgetType": "text-editor"
            },
            {
              "id": "b035413",
              "elType": "widget",
              "settings": {
                "space": {
                  "unit": "px",
                  "size": 18,
                  "sizes": []
                }
              },
              "elements": [],
              "widgetType": "spacer"
            },
            {
              "id": "3ce3338",
              "elType": "widget",
              "settings": {
                "editor": "<p>Convened with Third World Network, the conference featured leading international voices including Jeremy Corbyn.</p>",
                "text_color": "#2A3B32",
                "typography_typography": "custom",
                "typography_font_family": "Manrope",
                "typography_font_size": {
                  "unit": "px",
